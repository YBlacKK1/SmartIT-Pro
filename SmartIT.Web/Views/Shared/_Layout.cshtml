<!doctype html><html data-bs-theme="light"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>SmartIT Pro</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/><link href="~/css/site.css" rel="stylesheet"/></head><body class="bg-body-tertiary"><nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm"><div class="container"><a class="navbar-brand fw-bold" asp-controller="Home">SmartIT Pro</a><button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#nav">☰</button><div id="nav" class="collapse navbar-collapse"><ul class="navbar-nav me-auto"><li class="nav-item"><a class="nav-link" asp-controller="Employees">Employees</a></li><li class="nav-item"><a class="nav-link" asp-controller="Assets">Assets</a></li><li class="nav-item"><a class="nav-link" asp-controller="Tickets">Help Desk</a></li><li class="nav-item"><a class="nav-link" asp-controller="Reports" asp-action="AssetsExcel">Reports</a></li></ul><button id="theme" class="btn btn-sm btn-outline-light me-2">Dark</button>@if(User.Identity?.IsAuthenticated==true){<form asp-controller="Account" asp-action="Logout"><button class="btn btn-sm btn-light">Logout</button></form>}</div></div></nav><main class="container py-4"><div id="toast" class="alert alert-info d-none"></div>@RenderBody()</main><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script><script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script><script>document.getElementById('theme').onclick=()=>{let h=document.documentElement;h.dataset.bsTheme=h.dataset.bsTheme==='dark'?'light':'dark'};let c=new signalR.HubConnectionBuilder().withUrl('/hubs/notifications').build();c.on('notification',m=>{let t=document.getElementById('toast');t.textContent=m;t.classList.remove('d-none')});c.start();</script>@await RenderSectionAsync("Scripts",false)</body></html>
