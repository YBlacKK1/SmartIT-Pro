@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    var pageTitle = ViewData["Title"]?.ToString() ?? "Dashboard";
    string NavClass(string controller, string? action = null) =>
        string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase) &&
        (action is null || string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase))
            ? "app-nav-link active"
            : "app-nav-link";
    var userName = User.Identity?.Name ?? "SmartIT User";
    var initial = userName.Length > 0 ? userName[..1].ToUpperInvariant() : "S";
}
<!doctype html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="SmartIT Pro enterprise IT operations and help desk platform" />
    <title>@pageTitle · SmartIT Pro</title>
    <script>
        (() => {
            const saved = localStorage.getItem('smartit-theme');
            const dark = window.matchMedia?.('(prefers-color-scheme: dark)').matches;
            document.documentElement.dataset.bsTheme = saved || (dark ? 'dark' : 'light');
        })();
    </script>
    <link rel="preconnect" href="https://cdn.jsdelivr.net" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>
<body class="@(User.Identity?.IsAuthenticated == true ? "app-body" : "auth-body")">
@if (User.Identity?.IsAuthenticated == true)
{
    <div class="app-shell">
        <aside class="app-sidebar" id="appSidebar">
            <a class="brand" asp-controller="Home" asp-action="Index" aria-label="SmartIT Pro home">
                <span class="brand-mark">S</span>
                <span>
                    <strong>SmartIT</strong>
                    <small>PRO · v1.0</small>
                </span>
            </a>

            <nav class="app-nav" aria-label="Primary navigation">
                <div class="nav-label">Workspace</div>
                <a class='@NavClass("Home")' asp-controller="Home" asp-action="Index">
                    <span class="nav-icon">⌂</span><span>Dashboard</span>
                </a>
                <a class='@NavClass("Tickets")' asp-controller="Tickets" asp-action="Index">
                    <span class="nav-icon">◎</span><span>Help Desk</span>
                </a>
                <a class='@NavClass("Assets")' asp-controller="Assets" asp-action="Index">
                    <span class="nav-icon">▣</span><span>Asset Inventory</span>
                </a>
                <a class='@NavClass("Employees")' asp-controller="Employees" asp-action="Index">
                    <span class="nav-icon">♙</span><span>Employees</span>
                </a>

                @if (User.IsInRole("Admin"))
                {
                    <div class="nav-label mt-4">Operations</div>
                    <a class='@NavClass("Reports")' asp-controller="Reports" asp-action="Index">
                        <span class="nav-icon">↗</span><span>Reports</span>
                    </a>
                    <a class='@NavClass("Operations", "Licenses")' asp-controller="Operations" asp-action="Licenses">
                        <span class="nav-icon">◇</span><span>Licenses</span>
                    </a>
                    <a class='@NavClass("Operations", "Maintenance")' asp-controller="Operations" asp-action="Maintenance">
                        <span class="nav-icon">⚙</span><span>Maintenance</span>
                    </a>
                    <a class='@NavClass("Operations", "Audit")' asp-controller="Operations" asp-action="Audit">
                        <span class="nav-icon">≡</span><span>Audit Log</span>
                    </a>
                }
            </nav>

            <div class="sidebar-footer">
                <div class="system-status"><span></span> All systems operational</div>
                <small>SmartIT Pro Foundation Release</small>
            </div>
        </aside>

        <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

        <section class="app-main">
            <header class="app-topbar">
                <div class="d-flex align-items-center gap-3">
                    <button class="icon-button d-lg-none" type="button" id="sidebarToggle" aria-label="Open menu">☰</button>
                    <div>
                        <div class="eyebrow">IT OPERATIONS CENTER</div>
                        <h1 class="topbar-title">@pageTitle</h1>
                    </div>
                </div>

                <div class="topbar-actions">
                    <button class="icon-button" type="button" id="themeToggle" aria-label="Toggle theme">◐</button>
                    <div class="user-menu">
                        <span class="avatar avatar-sm">@initial</span>
                        <span class="user-copy d-none d-md-flex">
                            <strong>@userName</strong>
                            <small>@(User.IsInRole("Admin") ? "Administrator" : "Team member")</small>
                        </span>
                    </div>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button class="button button-ghost button-sm" type="submit">Sign out</button>
                    </form>
                </div>
            </header>

            <main class="app-content">
                @if (TempData["Success"] is string success)
                {
                    <div class="app-alert success" role="alert"><span>✓</span>@success</div>
                }
                @if (TempData["Error"] is string error)
                {
                    <div class="app-alert danger" role="alert"><span>!</span>@error</div>
                }
                <div id="liveNotification" class="app-alert info d-none" role="status"></div>
                @RenderBody()
            </main>
        </section>
    </div>
}
else
{
    <main class="auth-shell">
        @RenderBody()
    </main>
}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@if (User.Identity?.IsAuthenticated == true)
{
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
}
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
