@model IEnumerable<EmployeeDto>
<div class="d-flex justify-content-between mb-3"><h1 class="h3">Employees</h1><a asp-action="Create" class="btn btn-primary">Add employee</a></div><div class="card"><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>Name</th><th>Email</th><th>Title</th><th>Department</th><th></th></tr></thead><tbody>@foreach(var e in Model){<tr><td>@e.FirstName @e.LastName</td><td>@e.Email</td><td>@e.JobTitle</td><td>@e.DepartmentName</td><td><a asp-action="Edit" asp-route-id="@e.Id" class="btn btn-sm btn-outline-primary">Edit</a></td></tr>}</tbody></table></div></div>
