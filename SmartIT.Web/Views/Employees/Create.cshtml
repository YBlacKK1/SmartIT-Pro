@model EmployeeDto
@{
    ViewData["Title"] = "Add employee";
}
<div class="page-header">
    <div><h2>Create employee profile</h2><p>Add a new person to the SmartIT organization directory.</p></div>
    <a asp-action="Index" class="button button-secondary">← Back to employees</a>
</div>

<form asp-action="Create" method="post" enctype="multipart/form-data" class="panel">
    <div class="panel-header"><div><h3>Profile information</h3><p>Basic contact and organization details</p></div></div>
    <div class="panel-body">
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors mb-3"></div>
        <div class="row g-3">
            <div class="col-md-6"><label asp-for="FirstName" class="form-label"></label><input asp-for="FirstName" class="form-control" /><span asp-validation-for="FirstName" class="field-validation-error"></span></div>
            <div class="col-md-6"><label asp-for="LastName" class="form-label"></label><input asp-for="LastName" class="form-control" /><span asp-validation-for="LastName" class="field-validation-error"></span></div>
            <div class="col-md-6"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" type="email" /><span asp-validation-for="Email" class="field-validation-error"></span></div>
            <div class="col-md-6"><label asp-for="JobTitle" class="form-label"></label><input asp-for="JobTitle" class="form-control" placeholder="e.g. Network Specialist" /><span asp-validation-for="JobTitle" class="field-validation-error"></span></div>
            <div class="col-md-6"><label asp-for="DepartmentId" class="form-label">Department</label><select asp-for="DepartmentId" class="form-select" asp-items="@(new SelectList(ViewBag.Departments, "Id", "Name"))"><option value="">Select department</option></select><span asp-validation-for="DepartmentId" class="field-validation-error"></span></div>
            <div class="col-md-6"><label class="form-label">Profile photo</label><input name="photo" type="file" accept="image/jpeg,image/png,image/webp" class="form-control" /><div class="form-text">JPG, PNG or WEBP · Maximum 5 MB</div></div>
        </div>
        <div class="form-actions"><button class="button button-primary" type="submit">Save employee</button><a asp-action="Index" class="button button-ghost">Cancel</a></div>
    </div>
</form>
