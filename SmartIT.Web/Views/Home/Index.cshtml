@model DashboardDto
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h3 mb-0">Operations Dashboard</h1><small class="text-body-secondary">Live IT estate overview</small></div><span class="badge text-bg-success">System healthy</span></div><div class="row g-3 mb-4"><div class="col-md-3"><div class="card stat"><div class="card-body"><small>Employees</small><h2>@Model.Employees</h2></div></div></div><div class="col-md-3"><div class="card stat"><div class="card-body"><small>Assets</small><h2>@Model.Assets</h2></div></div></div><div class="col-md-3"><div class="card stat"><div class="card-body"><small>Open tickets</small><h2>@Model.OpenTickets</h2></div></div></div><div class="col-md-3"><div class="card stat"><div class="card-body"><small>Assigned</small><h2>@Model.AssignedAssets</h2></div></div></div></div><div class="row g-4"><div class="col-lg-6"><div class="card"><div class="card-body"><h2 class="h5">Device status</h2><canvas id="chart"></canvas></div></div></div><div class="col-lg-6"><div class="card"><div class="card-body"><h2 class="h5">Recent tickets</h2><table class="table table-sm"><thead><tr><th>Number</th><th>Subject</th><th>Status</th></tr></thead><tbody>@foreach(var t in Model.RecentTickets){<tr><td>@t.Number</td><td>@t.Subject</td><td><span class="badge text-bg-secondary">@t.Status</span></td></tr>}</tbody></table></div></div></div></div><script src="https://cdn.jsdelivr.net/npm/chart.js"></script><script>new Chart(document.getElementById('chart'),{type:'doughnut',data:{labels:@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AssetStatus.Keys)),datasets:[{data:@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AssetStatus.Values)),backgroundColor:['#0d6efd','#198754','#ffc107','#dc3545']}]}})</script>
