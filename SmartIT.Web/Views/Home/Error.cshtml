@{
    ViewData["Title"] = "Something went wrong";
}
<div class="error-page">
    <div>
        <div class="error-code">500</div>
        <h2>Something went wrong</h2>
        <p class="text-body-secondary">The request could not be completed. Check the application console for details.</p>
        <a asp-controller="Home" asp-action="Index" class="button button-primary mt-3">Return to dashboard</a>
    </div>
</div>
