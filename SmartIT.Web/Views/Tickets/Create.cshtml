@model TicketDto
<h1 class="h3">New help desk ticket</h1><form method="post" class="card p-4"><div class="mb-3"><label asp-for="Subject" class="form-label"></label><input asp-for="Subject" class="form-control"/></div><div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="5"></textarea></div><div class="row"><div class="col-md-4"><label asp-for="Priority" class="form-label"></label><select asp-for="Priority" asp-items="Html.GetEnumSelectList<TicketPriority>()" class="form-select"></select></div></div><input asp-for="Status" type="hidden"/><input asp-for="CreatedAt" type="hidden"/><button class="btn btn-primary mt-4">Submit ticket</button></form>
