@model AssetDto
@{
    ViewData["Title"] = "Add asset";
}
<div class="page-header">
    <div><h2>Register a new asset</h2><p>Add equipment to the inventory and define its initial status.</p></div>
    <a asp-action="Index" class="button button-secondary">← Back to inventory</a>
</div>

<form asp-action="Create" method="post" class="panel">
    <div class="panel-header"><div><h3>Asset information</h3><p>Identification, hardware and lifecycle details</p></div></div>
    <div class="panel-body">
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors mb-3"></div>
        <div class="row g-3">
            <div class="col-md-6"><label asp-for="AssetTag" class="form-label"></label><input asp-for="AssetTag" class="form-control" placeholder="LAP-0001" /><span asp-validation-for="AssetTag" class="field-validation-error"></span></div>
            <div class="col-md-6"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" placeholder="Developer Laptop" /><span asp-validation-for="Name" class="field-validation-error"></span></div>
            <div class="col-md-4"><label asp-for="Type" class="form-label"></label><select asp-for="Type" asp-items="Html.GetEnumSelectList<AssetType>()" class="form-select"></select></div>
            <div class="col-md-4"><label asp-for="Status" class="form-label"></label><select asp-for="Status" asp-items="Html.GetEnumSelectList<AssetStatus>()" class="form-select"></select></div>
            <div class="col-md-4"><label asp-for="Manufacturer" class="form-label"></label><input asp-for="Manufacturer" class="form-control" /></div>
            <div class="col-md-6"><label asp-for="Model" class="form-label"></label><input asp-for="Model" class="form-control" /></div>
            <div class="col-md-6"><label asp-for="SerialNumber" class="form-label"></label><input asp-for="SerialNumber" class="form-control" /><span asp-validation-for="SerialNumber" class="field-validation-error"></span></div>
        </div>
        <div class="form-actions"><button class="button button-primary" type="submit">Register asset</button><a asp-action="Index" class="button button-ghost">Cancel</a></div>
    </div>
</form>
