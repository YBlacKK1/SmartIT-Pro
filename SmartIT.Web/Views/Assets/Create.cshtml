@model AssetDto
<h1 class="h3">New asset</h1><form method="post" class="card p-4"><div class="row g-3"><div class="col-md-6"><label asp-for="AssetTag" class="form-label"></label><input asp-for="AssetTag" class="form-control"/></div><div class="col-md-6"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control"/></div><div class="col-md-4"><label asp-for="Type" class="form-label"></label><select asp-for="Type" asp-items="Html.GetEnumSelectList<AssetType>()" class="form-select"></select></div><div class="col-md-4"><label asp-for="Status" class="form-label"></label><select asp-for="Status" asp-items="Html.GetEnumSelectList<AssetStatus>()" class="form-select"></select></div><div class="col-md-4"><label asp-for="Manufacturer" class="form-label"></label><input asp-for="Manufacturer" class="form-control"/></div><div class="col-md-6"><label asp-for="Model" class="form-label"></label><input asp-for="Model" class="form-control"/></div><div class="col-md-6"><label asp-for="SerialNumber" class="form-label"></label><input asp-for="SerialNumber" class="form-control"/></div></div><button class="btn btn-primary mt-4">Save</button></form>
