@model IEnumerable<AssetDto>
<div class="d-flex justify-content-between mb-3"><h1 class="h3">Asset inventory</h1><a asp-action="Create" class="btn btn-primary">Add asset</a></div><div class="card"><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>Tag</th><th>Name</th><th>Type</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var a in Model){<tr><td>@a.AssetTag</td><td>@a.Name</td><td>@a.Type</td><td><span class="badge text-bg-info">@a.Status</span></td><td><a asp-action="Edit" asp-route-id="@a.Id" class="btn btn-sm btn-outline-primary">Edit</a> <a asp-controller="Reports" asp-action="Qr" asp-route-id="@a.Id" class="btn btn-sm btn-outline-secondary">QR</a></td></tr>}</tbody></table></div></div>
