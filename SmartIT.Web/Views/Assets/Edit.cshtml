@model AssetDto
@{
    ViewData["Title"] = "Edit asset";
}
<div class="page-header">
    <div><h2>Edit @Model.AssetTag</h2><p>Update device information and current lifecycle status.</p></div>
    <a asp-action="Details" asp-route-id="@Model.Id" class="button button-secondary">← Back to details</a>
</div>

<form asp-action="Edit" method="post" class="panel">
    <input asp-for="Id" type="hidden" />
    <div class="panel-header"><div><h3>Asset information</h3><p>@Model.Name</p></div></div>
    <div class="panel-body">
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors mb-3"></div>
        <div class="row g-3">
            <div class="col-md-6"><label asp-for="AssetTag" class="form-label"></label><input asp-for="AssetTag" class="form-control" /><span asp-validation-for="AssetTag" class="field-validation-error"></span></div>
            <div class="col-md-6"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="field-validation-error"></span></div>
            <div class="col-md-4"><label asp-for="Type" class="form-label"></label><select asp-for="Type" asp-items="Html.GetEnumSelectList<AssetType>()" class="form-select"></select></div>
            <div class="col-md-4"><label asp-for="Status" class="form-label"></label><select asp-for="Status" asp-items="Html.GetEnumSelectList<AssetStatus>()" class="form-select"></select></div>
            <div class="col-md-4"><label asp-for="Manufacturer" class="form-label"></label><input asp-for="Manufacturer" class="form-control" /></div>
            <div class="col-md-6"><label asp-for="Model" class="form-label"></label><input asp-for="Model" class="form-control" /></div>
            <div class="col-md-6"><label asp-for="SerialNumber" class="form-label"></label><input asp-for="SerialNumber" class="form-control" /><span asp-validation-for="SerialNumber" class="field-validation-error"></span></div>
        </div>
        <div class="form-actions"><button class="button button-primary" type="submit">Save changes</button><a asp-action="Details" asp-route-id="@Model.Id" class="button button-ghost">Cancel</a></div>
    </div>
</form>
